rules_version = '2';
// GD&T in 3D — Firestore security rules.
// These rules are the real lock. Hiding buttons in the page is not security.
// Mirrors can() / canOpen() in index.html and the spec in claude/site-access-spec.md.
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- who is asking ----------
    // The one email allowed to set the site up the very first time (bootstrap).
    function bootstrapEmail() { return 'interactive.gd.t@gmail.com'; }

    function signedIn()  { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail()   { return request.auth.token.email.lower(); }
    function meDoc()     { return /databases/$(db)/documents/people/$(myEmail()); }
    function me()        { return get(meDoc()).data; }
    function active()    { return signedIn() && exists(meDoc()) && me().status == 'active'; }
    function role()      { return me().role; }
    function isTop()     { return active() && role() in ['owner','admin']; }
    function isManager() { return active() && role() in ['owner','admin','creator']; }
    function isStaff()   { return active() && role() in ['owner','admin','creator','instructor']; }
    function groupDoc(g) { return get(/databases/$(db)/documents/groups/$(g)).data; }
    function teaches(g)  { return active() && role() == 'instructor' && g != null && myEmail() in groupDoc(g).instructors; }
    function isStudentRole(r) { return r in ['student_full','student_partial']; }
    function canInviteStaff(r) {
      return active() && ((role() == 'owner' && r in ['admin','creator','instructor'])
                       || (role() == 'admin' && r in ['creator','instructor']));
    }
    function configPath() { return /databases/$(db)/documents/site/config; }
    function canOpen(itemId) {
      let it = get(/databases/$(db)/documents/catalog/$(itemId)).data;
      return active() && (
        isManager() ||
        (it.status == 'published' && (
          role() in ['instructor','student_full'] ||
          (role() == 'student_partial' && me().group != null && itemId in groupDoc(me().group).allowed))));
    }
    // Fields a person record may hold.
    function personShapeOK(d) {
      return d.keys().hasOnly(['name','role','status','group','invitedBy','invitedAt','pinSet'])
          && d.role in ['owner','admin','creator','instructor','student_full','student_partial']
          && d.status in ['invited','active'];
    }

    // ---------- site config ----------
    match /site/config {
      allow read: if active();
      // first-time setup: only the bootstrap email, only while no config exists
      allow create: if signedIn() && myEmail() == bootstrapEmail() && !exists(configPath())
                    && request.resource.data.ownerEmail == myEmail();
      // ownership hand-over (Owner only)
      allow update: if active() && role() == 'owner'
                    && request.resource.data.keys().hasOnly(['ownerEmail']);
    }

    // ---------- people (keyed by lowercase email) ----------
    match /people/{e} {
      allow read: if active() && (e == myEmail() || isManager()
                    || (isStaff() && resource.data.group == null)          // staff see the staff list
                    || (resource.data.group != null && teaches(resource.data.group)));
      // an invited person can always read their own record, so the page can show "finish sign-up"
      allow get: if signedIn() && e == myEmail();

      // bootstrap: the very first Owner record, written in the same batch as site/config
      allow create: if signedIn() && e == myEmail() && myEmail() == bootstrapEmail()
                    && !exists(configPath())
                    && request.resource.data.role == 'owner' && request.resource.data.status == 'active'
                    && personShapeOK(request.resource.data);

      // managers invite students into a group; owner/admin invite staff (no group)
      allow create: if e == e.lower() && personShapeOK(request.resource.data)
                    && request.resource.data.status == 'invited'
                    && ((isManager() && isStudentRole(request.resource.data.role) && request.resource.data.group != null)
                     || (canInviteStaff(request.resource.data.role) && request.resource.data.group == null));

      // an invited person activates their own record on first sign-in (name + status only)
      allow update: if signedIn() && e == myEmail() && resource.data.status == 'invited'
                    && request.resource.data.status == 'active'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','status','pinSet']);

      // a person may change their own display name and mark their PIN as set
      allow update: if active() && e == myEmail()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','pinSet']);

      // managers change students (Full/Partial); owner/admin change staff below them
      allow update: if active() && resource.data.role != 'owner' && personShapeOK(request.resource.data)
                    && request.resource.data.group == resource.data.group
                    && ((isManager() && isStudentRole(resource.data.role) && isStudentRole(request.resource.data.role))
                     || (canInviteStaff(resource.data.role) && canInviteStaff(request.resource.data.role)));

      // ownership hand-over, done as ONE batch by the Owner:
      //   site/config.ownerEmail -> new owner, new owner admin -> owner, old owner owner -> admin
      allow update: if active() && role() == 'owner' && e != myEmail()
                    && resource.data.role == 'admin' && request.resource.data.role == 'owner'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                    && getAfter(configPath()).data.ownerEmail == e;
      allow update: if active() && role() == 'owner' && e == myEmail()
                    && request.resource.data.role == 'admin'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                    && getAfter(configPath()).data.ownerEmail != myEmail()
                    && getAfter(/databases/$(db)/documents/people/$(getAfter(configPath()).data.ownerEmail)).data.role == 'owner';

      allow delete: if active() && resource.data.role != 'owner' && (
                       (isManager() && isStudentRole(resource.data.role)) || canInviteStaff(resource.data.role));
    }

    // ---------- company groups ----------
    match /groups/{g} {
      // resource.data (not get()) so an instructor's array-contains query can be proven by the rules
      allow read: if isManager()
                  || (active() && role() == 'instructor' && myEmail() in resource.data.instructors)
                  || (active() && me().group == g);
      allow create, update: if isManager()
                    && request.resource.data.keys().hasOnly(['name','allowed','instructors','created','createdBy'])
                    && request.resource.data.allowed is list && request.resource.data.instructors is list;
      allow delete: if isTop();
    }

    // ---------- catalog: lessons, tools, problems ----------
    match /catalog/{id} {
      allow read: if active();
      allow write: if isManager();
    }
    // lesson / tool page bodies, loaded only after sign-in
    match /content/{id} {
      allow read: if canOpen(id);
      allow write: if isManager();
    }

    // ---------- progress: one doc per person, map of itemId -> {opened, quiz, score} ----------
    match /progress/{e} {
      allow read: if active() && (e == myEmail() || isManager()
                    || teaches(get(/databases/$(db)/documents/people/$(e)).data.group));
      allow write: if active() && e == myEmail();
      allow delete: if isManager();
    }

    // ---------- access requests from the public landing form ----------
    match /requests/{id} {
      // "false &&" = form closed for now. Delete those two words (and set REQUESTS_OPEN in index.html) to reopen.
      allow create: if false && request.resource.data.keys().hasOnly(['company','contact','email','size','note','date','done'])
                    && request.resource.data.done == false
                    && request.resource.data.company is string && request.resource.data.company.size() <= 200
                    && request.resource.data.note is string && request.resource.data.note.size() <= 2000;
      allow read, update, delete: if isManager();
    }
  }
}
